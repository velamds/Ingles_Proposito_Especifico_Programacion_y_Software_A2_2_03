tion", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Activity 2", "type": "group_name"}]}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 12, "type": "EXT1"}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"_data": [], "contents": [{}], "template_override": 1, "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "type": "audio", "title": "", "id": 1, "contents": [{"value": {"coverimg": "enpe7n4le03ob01re2img01.jpg", "images": [{"time": "100", "text": "<strong>Tanya:</strong> Mark, we got to study for our test. It's about inheritance.</br>\n<strong>Mark:</strong> I used to think that the term inheritance did not apply to programming languages.</br>\n<strong>Tanya:</strong> It does! That's why the teacher is including it in the quiz. Let's clarify what inheritance is. </br>\n<strong>Mark:</strong> Inheritance is basing an object or class on another object by using the same one or by identifying a new implementation to maintain the same behavior. This inherited class is called a subclass.", "image": "enpe7n4le03ob01re2img01.jpg", "id": 0}, {"time": "59500", "text": "<strong>Tanya:</strong> To relate objects or classes through inheritance creates hierarchy. I mean, inheritance builds a syntactic relationship among objects and classes. </br>\n<strong>Mark:</strong> I used to believe that inheritance created a semantic relationship. </br>\n<strong>Tanya:</strong> Not necessarily. It doesn't even ensure a behavioral subtyping. </br>\n<strong>Mark:</strong> What about the types of inheritance? I know that people used to classify inheritance based on specific languages. </br>\n<strong>Tanya:</strong> That's right! There is the single inheritance, where the class gets the properties of another class; or the multiple inheritance, where one class inherits characteristics from all parent classes. </br>\n<strong>Mark:</strong> I used to know about hierarchical inheritance, but I don't remember well.</br>\n<strong>Tanya:</strong> It's when one class assists as a superclass. Another important type of inheritance is the hybrid one. Mixing two or more types of inheritance is called hybrid inheritance. </br>", "image": "enpe7n4le03ob01re2img02.jpg", "id": 1}, {"time": "125000", "text": "<strong>Mark:</strong> But there is something we need to know, what's the relation between this topic and object-oriented programming? Is it the same?</br>\n<strong>Tanya:</strong> Well, object-oriented programming is a programming paradigm that involves objects that have data as fields, known as attributes; and codes which we call methods. Inheritance is just a feature of this paradigm. </br>\n<strong>Mark:</strong> It also uses objects, right?</br>\n<strong>Tanya:</strong> Of course! To design computer programs, it requires objects that interact with one another. </br>\n<strong>Mark:</strong> I feel ready for that test now!", "image": "enpe7n4le03ob01re2img03.jpg", "id": 2}], "audiosrc": "enpe7n4le03ob01re2aud01"}, "type": "slideshow"}]}], "id": 0, "type": "scholar"}]}